{
  "name": "@buildvision/nest-sdk-generator",
  "author": "BuildVision <christophe@buildvision.io>",
  "version": "3.0.0",
  "description": "Generate fully-typed RTK Query API clients from NestJS controllers",
  "keywords": [
    "nest",
    "nestjs",
    "rtk-query",
    "redux-toolkit",
    "redux",
    "react",
    "api-client",
    "sdk",
    "generator",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/build-vision/nest-sdk-generator.git"
  },
  "homepage": "https://github.com/build-vision/nest-sdk-generator#readme",
  "bugs": {
    "url": "https://github.com/build-vision/nest-sdk-generator/issues"
  },
  "main": "build/bin.js",
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf build && node node_modules/typescript/bin/tsc -p tsconfig.json --outDir build",
    "build:baseline": "./scripts/build-baseline.sh",
    "start": "npm run build && node build/bin.js",
    "test": "npm run build && node --test 'test/*.test.mjs'",
    "typecheck": "node node_modules/typescript/bin/tsc --project tsconfig.json --noEmit",
    "lint": "node --require ./scripts/eslint-with-typescript-6.cjs node_modules/eslint/bin/eslint.js --quiet . --fix"
  },
  "bin": "build/bin.js",
  "dependencies": {
    "chalk": "~4.1.2",
    "minimist": "~1.2.7",
    "prettier": "^3.2.5",
    "ts-morph": "~16.0.0",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "@types/minimist": "^1.2.2",
    "@types/node": "~18.11.9",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-sort-destructure-keys": "^1.5.0",
    "eslint-plugin-typescript-sort-keys": "^3.1.0",
    "react": "^19.3.0",
    "react-redux": "^9.3.0",
    "typescript-6": "npm:typescript@6.0.3"
  }
}
