{
  // A React client consuming the generated RTK Query client, set up as described in the README
  "compilerOptions": {
    "strict": true,
    // Required to type-check the API's files imported by the generated client (see README)
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "jsx": "react-jsx",
    "types": [],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
